# Archivo de configuración (copiar a .env y completar valores)
# En producción (Railway): configurar estas variables en el panel de Railway, NO subir .env al repo.

# --- Supabase ---
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Base de datos (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/[database]

# --- Auth ---
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# --- Entorno ---
NODE_ENV=development

# --- URLs de la aplicación ---
# Producción: usar la URL pública (ej. https://tu-app.railway.app o dominio custom)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# --- Stripe (producción: claves LIVE) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# El webhook en Stripe debe apuntar a: https://<tu-backend>/api/webhooks/stripe

# --- Cliente (Vite) - deben empezar con VITE_ ---
# En Railway: definirlas en el servicio que hace el build del client para que estén en el bundle
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Email (opcional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- Google OAuth ---
# En producción: añadir en Google Cloud la URI de redirección del backend (ver docs/DEPLOY-RAILWAY.md)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret